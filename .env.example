# 环境变量示例（复制为 .env 并按需修改；测试环境使用 .env.test，由 APP_ENV_FILE 指定）

# 运行环境：development | test | production
APP_ENV=development

# MySQL 异步连接串（SQLAlchemy asyncmy 驱动）
# 本地 devbox MySQL：127.0.0.1:3306，root 无密码（devbox mysql80 默认 insecure 模式）
#
# 双库约定（同一 MySQL 实例）：
#   - ecommerce_dev  — task dev、task migrate 默认目标（开发）
#   - ecommerce_test — pytest @integration 测试专用（零副作用靠 transaction rollback）
#
# 开发默认（复制到 .env 后用于 task dev / task migrate）：
# 本地 devbox 通过 unix socket 连接（见 devbox.d/mysql80/my.cnf）
DATABASE_URL=mysql+asyncmy://root@localhost/ecommerce_dev?charset=utf8mb4&unix_socket=/tmp/e-commerce-system-mysql.sock
#
# 运行 integration 测试时改为 test 库，例如：
# DATABASE_URL=mysql+asyncmy://root@localhost/ecommerce_test?charset=utf8mb4&unix_socket=/tmp/e-commerce-system-mysql.sock
#
# CI 环境使用 TCP（GitHub Actions mysql service container）：
# DATABASE_URL=mysql+asyncmy://root@127.0.0.1:3306/ecommerce_test?charset=utf8mb4

# JWT access token（HS256；密钥长度须 ≥ 32 字节）
JWT_SECRET_KEY=dev-only-change-me-use-at-least-32-chars!!
JWT_ISSUER=e-commerce-system
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Redis ─────────────────────────────────────────────────────
# 本地 devbox Redis 8.0 单实例；逻辑库分离约定：
#   - db 0 — 本地开发（task dev）
#   - db 1 — pytest integration 与 CI（与 .env.test 对齐）
#
# 开发默认：
REDIS_URL=redis://127.0.0.1:6379/0
#
# 测试环境用 /1：
# REDIS_URL=redis://127.0.0.1:6379/1
#
# 启动 Redis：devbox run -- task redis:up

# ─── AI 读库（PostgreSQL + pgvector）──────────────────────────────
# 本地 devbox PostgreSQL 16；双库约定：
#   - ecommerce_ai_dev  — task dev、本地 .env 默认
#   - ecommerce_ai_test — pytest @integration 与 CI
#
# 开发默认（复制到 .env 后用于 task dev / task migrate:ai）：
AI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/ecommerce_ai_dev
#
# integration 测试 / CI 使用 test AI 库：
# AI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/ecommerce_ai_test
#
# Embedding（须显式配置；无 Settings default）
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding
EMBEDDING_DIMENSION=1024
# EMBEDDING_API_KEY=   # mock 可省略；真 API 本地配置
#
# ─── 客服 LLM 与 τ 门禁（均有 Settings default；CI/默认测试用 mock）────────
# LLM_PROVIDER=mock       # mock（CI/默认）| deepseek（dev 手验）
# LLM_MODEL=mock-model
# LLM_API_KEY=           # deepseek 时配置
# LLM_BASE_URL=https://api.deepseek.com
# TAU_THRESHOLD=0.3      # τ 最小门禁（[0,1]；低于则拒答转人工）
#
# 启动 PostgreSQL：devbox run -- task pg:up

# 订单待支付预留超时（秒）：超出时限后懒释放终态 cancelled + expired；测试可设短值（如 10）
# ORDER_RESERVATION_TTL_SECONDS=86400

# ─── SMS OTP（部分参数可 env 覆盖；仅测试环境可选）────────────────────
# SMS_OTP_TTL_SECONDS=300
# SMS_DAILY_SEND_LIMIT=10
# SMS_VERIFY_FAIL_LIMIT=5
# SMS_VERIFY_FAIL_WINDOW_SECONDS=900
# 固定 OTP code（仅测试/开发环境使用；生产环境不应设置）
# SMS_OTP_FIXED_CODE=

# ─── engagement 浏览记录（user_browse_history）──────────────────
# 配置化 top N + retention + debounce（生产由 cron 独立进程执行 task browse:trim）
# BROWSE_HISTORY_MAX_PER_USER=50     # trim 每用户保留最近 N 条
# BROWSE_HISTORY_RETENTION_DAYS=30   # retention 天数（timedelta(days=N)）
# BROWSE_DEBOUNCE_SECONDS=5          # debounce 窗口（秒）

# ─── media 平台域 ─────────────────────────────────────────────────
# 存储后端：local（落盘 MEDIA_STORAGE_ROOT）| memory（进程内，测试用）
# MEDIA_STORAGE_BACKEND=local
# 本地存储根目录（仅 local backend 生效），默认 .data/media（gitignored）
# MEDIA_STORAGE_ROOT=.data/media
# 上传文件大小上限（字节），默认 5 MB
# MEDIA_MAX_SIZE_BYTES=5242880
# 每用户每窗口最多上传次数（Redis 滑动窗口限速）
# MEDIA_UPLOAD_RATE_LIMIT_PER_MINUTE=60

# ─── 测试环境（.env.test）────────────────────────────────────────
# 项目使用 `.env.test` 作为 integration/CI 测试环境配置。
# `task test` / CI 会自动设置 APP_ENV_FILE=.env.test。
# 参见 `.env.test`（gitignored，已创建，不入库）。
#
# integration 测试除 MySQL / Redis 外，还须在本机 `.env.test` 同步：
#   AI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/ecommerce_ai_test
#   EMBEDDING_PROVIDER=mock
#   EMBEDDING_MODEL=mock-embedding
#   EMBEDDING_DIMENSION=1024
# 并执行 `devbox run -- task pg:up`（CI 由 workflow env 覆盖，不读 `.env.test` 文件）。
#
# ─── 日志（loguru）─────────────────────────────────────────────────
# 日志格式与级别由 APP_ENV 推导：
#   development — 终端人类可读（INFO），logs/app.log JSON + rotation + gzip
#   test        — 终端 JSON（WARNING），不写 logs/app.log
#   production  — 终端 JSON（INFO），logs/app.log JSON + rotation + gzip
# logs/ 目录已 gitignore，启动时自动创建。
#
# 手动运行测试：
#   APP_ENV_FILE=.env.test uv run pytest tests/xxx -x
#
# 优先级：os.environ > .env.test  > .env
# （CI 中 DATABASE_URL 通过 workflow env 覆盖文件内容）
