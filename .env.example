# 环境变量示例（复制为 .env 并按需修改；测试环境使用 .env.test，由 APP_ENV_FILE 指定）

# 运行环境：development | test | production
APP_ENV=development

# MySQL 异步连接串（SQLAlchemy asyncmy 驱动）
# 本地 devbox MySQL：127.0.0.1:3306，root 无密码（devbox mysql80 默认 insecure 模式）
#
# 双库约定（同一 MySQL 实例）：
#   - ecommerce_dev  — task dev、task migrate 默认目标（开发）
#   - ecommerce_test — pytest @integration 测试专用（零副作用靠 transaction rollback）
#
# 开发默认（复制到 .env 后用于 task dev / task migrate）：
# 本地 devbox 通过 unix socket 连接（见 devbox.d/mysql80/my.cnf）
DATABASE_URL=mysql+asyncmy://root@localhost/ecommerce_dev?charset=utf8mb4&unix_socket=/tmp/e-commerce-system-mysql.sock
#
# 运行 integration 测试时改为 test 库，例如：
# DATABASE_URL=mysql+asyncmy://root@localhost/ecommerce_test?charset=utf8mb4&unix_socket=/tmp/e-commerce-system-mysql.sock
#
# CI 环境使用 TCP（GitHub Actions mysql service container）：
# DATABASE_URL=mysql+asyncmy://root@127.0.0.1:3306/ecommerce_test?charset=utf8mb4

# JWT access token（HS256；密钥长度须 ≥ 32 字节）
JWT_SECRET_KEY=dev-only-change-me-use-at-least-32-chars!!
JWT_ISSUER=e-commerce-system
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Redis ─────────────────────────────────────────────────────
# 本地 devbox Redis 8.0 单实例；逻辑库分离约定：
#   - db 0 — 本地开发（task dev）
#   - db 1 — pytest integration 与 CI（与 .env.test 对齐）
#
# 开发默认：
REDIS_URL=redis://127.0.0.1:6379/0
#
# 测试环境用 /1：
# REDIS_URL=redis://127.0.0.1:6379/1
#
# 启动 Redis：devbox run -- task redis:up

# 订单待支付预留超时（秒）：超出时限后懒释放终态 cancelled + expired；测试可设短值（如 10）
# ORDER_RESERVATION_TTL_SECONDS=86400

# ─── SMS OTP（部分参数可 env 覆盖；仅测试环境可选）────────────────────
# SMS_OTP_TTL_SECONDS=300
# SMS_SEND_COOLDOWN_SECONDS=60
# SMS_DAILY_SEND_LIMIT=10
# SMS_VERIFY_FAIL_LIMIT=5
# 固定 OTP code（仅测试/开发环境使用；生产环境不应设置）
# SMS_OTP_FIXED_CODE=

# ─── 测试环境（.env.test）────────────────────────────────────────
# 项目使用 `.env.test` 作为 integration/CI 测试环境配置。
# `task test` / CI 会自动设置 APP_ENV_FILE=.env.test。
# 参见 `.env.test`（gitignored，已创建，不入库）。
#
# ─── 日志（loguru）─────────────────────────────────────────────────
# 日志格式与级别由 APP_ENV 推导：
#   development — 终端人类可读（INFO），logs/app.log JSON + rotation + gzip
#   test        — 终端 JSON（WARNING），不写 logs/app.log
#   production  — 终端 JSON（INFO），logs/app.log JSON + rotation + gzip
# logs/ 目录已 gitignore，启动时自动创建。
#
# 手动运行测试：
#   APP_ENV_FILE=.env.test uv run pytest tests/xxx -x
#
# 优先级：os.environ > .env.test  > .env
# （CI 中 DATABASE_URL 通过 workflow env 覆盖文件内容）
