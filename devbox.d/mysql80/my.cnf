[mysqld]
# 数据目录持久化到项目根 mysql-data/（见 .gitignore）
datadir = ./mysql-data
socket = /tmp/e-commerce-system-mysql.sock
# 本地 devbox 仅使用 socket，避免 3306 端口冲突与重启竞态
skip-networking
# 本地开发不需要 binlog（复制/CDC），减少 mysql-data 体积
skip-log-bin
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
mysqlx = 0

[client]
socket = /tmp/e-commerce-system-mysql.sock
default-character-set = utf8mb4
